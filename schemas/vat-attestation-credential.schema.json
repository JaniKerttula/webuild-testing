{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://we-build.example/schemas/vat-attestation-credential.schema.json",
  "title": "VAT Attestation Credential",
  "description": "Example credential claim schema derived from docs/vat_attestation_1.0.docx for use in iGrant EUDI issuance exercises.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "VAT_ID",
    "Administrative_Unit_Name",
    "Validity_Period",
    "Economic_Operator",
    "Issuer"
  ],
  "properties": {
    "VAT_ID": {
      "type": "string",
      "description": "Full VAT identification of the company including country identifier, without spaces or separators.",
      "pattern": "^[A-Z]{2}[A-Za-z0-9]+$",
      "examples": [
        "FI12345678"
      ]
    },
    "Administrative_Unit_Name": {
      "type": "string",
      "description": "Name of the administrative unit as registered by the tax administration.",
      "examples": [
        "We Build Oy Helsinki Operations"
      ]
    },
    "Administrative_Unit_Type": {
      "type": "string",
      "description": "Type of administrative unit ID. May be omitted when not available from the authentic source.",
      "examples": [
        "branch"
      ]
    },
    "Administrative_Unit_Address": {
      "$ref": "#/$defs/Address"
    },
    "Validity_Area_Limitation": {
      "type": "array",
      "description": "Country codes in which the VAT_ID may be used. Omit or leave empty when there are no restrictions.",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "uniqueItems": true,
      "examples": [
        [
          "FI",
          "SE"
        ]
      ]
    },
    "Validity_Period": {
      "type": "array",
      "description": "One or more validity periods for the VAT ID. Periods should not overlap.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ValidityPeriod"
      }
    },
    "Economic_Activity_Type": {
      "type": "array",
      "description": "Business or economic activity registrations associated with the administrative unit.",
      "items": {
        "$ref": "#/$defs/EconomicActivityType"
      }
    },
    "Economic_Operator": {
      "$ref": "#/$defs/EconomicOperator"
    },
    "Issuer": {
      "$ref": "#/$defs/Issuer"
    }
  },
  "$defs": {
    "Address": {
      "type": "object",
      "description": "Address object based on the core location vocabulary fields referenced in the VAT attestation document.",
      "additionalProperties": false,
      "properties": {
        "po_box": {
          "type": "string"
        },
        "thoroughfare": {
          "type": "string"
        },
        "location_designator": {
          "type": "string"
        },
        "post_code": {
          "type": "string"
        },
        "post_name": {
          "type": "string"
        },
        "admin_unit_L1": {
          "type": "string"
        },
        "admin_unit_L2": {
          "type": "string"
        }
      }
    },
    "ValidityPeriod": {
      "type": "object",
      "description": "Validity period for a VAT ID. The end date, when present, should be greater than or equal to the start date.",
      "additionalProperties": false,
      "required": [
        "VAT_ID_start_date"
      ],
      "properties": {
        "VAT_ID_start_date": {
          "type": "string",
          "format": "date",
          "description": "Date of registration of the VAT ID."
        },
        "VAT_ID_end_date": {
          "type": "string",
          "format": "date",
          "description": "End date after which VAT ID registration ended. Omit when unknown."
        }
      }
    },
    "EconomicActivityTypeDescription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Language",
        "Description"
      ],
      "properties": {
        "Language": {
          "type": "string",
          "description": "ISO 639-1 language code.",
          "pattern": "^[a-z]{2}$",
          "examples": [
            "en",
            "fi"
          ]
        },
        "Description": {
          "type": "string",
          "description": "Human-readable business activity description."
        }
      }
    },
    "EconomicActivityType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Economic_Activity_Type_Nomenclature",
        "Economic_Activity_Type_ID"
      ],
      "properties": {
        "Economic_Activity_Type_Nomenclature": {
          "type": "string",
          "description": "Nomenclature used to describe the administrative unit. NACE should be used when available.",
          "examples": [
            "NACE",
            "SBI",
            "NAF"
          ]
        },
        "Economic_Activity_Type_ID": {
          "type": "string",
          "description": "Identifier under which the administrative unit is registered in the nominated nomenclature.",
          "examples": [
            "41.20"
          ]
        },
        "Economic_Activity_Type_Description": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EconomicActivityTypeDescription"
          }
        }
      }
    },
    "EconomicOperator": {
      "type": "object",
      "description": "Legal entity or sole trader to which the VAT ID belongs.",
      "additionalProperties": false,
      "properties": {
        "EUID": {
          "type": "string",
          "description": "Company identifier following the BRIS structure.",
          "examples": [
            "FIHPR.1234567-8"
          ]
        },
        "PID": {
          "type": "string",
          "description": "Natural person identifier for sole traders."
        },
        "Economic_Operator_Name": {
          "type": "string",
          "description": "Name of the economic operator as registered by the tax administration.",
          "examples": [
            "We Build Oy"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "EUID"
          ]
        },
        {
          "required": [
            "PID"
          ]
        },
        {
          "required": [
            "Economic_Operator_Name"
          ]
        }
      ]
    },
    "Issuer": {
      "type": "object",
      "description": "Organisation that is the authentic source of the VAT ID and attestation issuance metadata.",
      "additionalProperties": false,
      "required": [
        "Issuing_country",
        "Issuing_Organisation",
        "Issuing_date",
        "Attestation_issuing_Organisation"
      ],
      "properties": {
        "Issuing_country": {
          "type": "string",
          "description": "Country code of the authority issuing the VAT ID.",
          "pattern": "^[A-Z]{2}$",
          "examples": [
            "FI"
          ]
        },
        "Issuing_Organisation": {
          "type": "string",
          "description": "Authentic source for the VAT-ID attestation.",
          "examples": [
            "Finnish Tax Administration"
          ]
        },
        "Issuing_date": {
          "type": "string",
          "format": "date",
          "description": "Date of issuing this attestation."
        },
        "Attestation_issuing_Organisation": {
          "type": "string",
          "description": "Organisation that issued the attestation artifact.",
          "examples": [
            "Finnish Tax Administration Digital Credentials Service"
          ]
        }
      }
    }
  },
  "examples": [
    {
      "VAT_ID": "FI12345678",
      "Administrative_Unit_Name": "We Build Oy Helsinki Operations",
      "Administrative_Unit_Type": "branch",
      "Administrative_Unit_Address": {
        "thoroughfare": "Aleksanterinkatu 12",
        "post_code": "00170",
        "post_name": "Helsinki",
        "admin_unit_L1": "Uusimaa",
        "admin_unit_L2": "Finland"
      },
      "Validity_Area_Limitation": [],
      "Validity_Period": [
        {
          "VAT_ID_start_date": "2023-01-01"
        }
      ],
      "Economic_Activity_Type": [
        {
          "Economic_Activity_Type_Nomenclature": "NACE",
          "Economic_Activity_Type_ID": "41.20",
          "Economic_Activity_Type_Description": [
            {
              "Language": "en",
              "Description": "Construction of residential and non-residential buildings"
            }
          ]
        }
      ],
      "Economic_Operator": {
        "EUID": "FIHPR.1234567-8",
        "Economic_Operator_Name": "We Build Oy"
      },
      "Issuer": {
        "Issuing_country": "FI",
        "Issuing_Organisation": "Finnish Tax Administration",
        "Issuing_date": "2026-04-14",
        "Attestation_issuing_Organisation": "Finnish Tax Administration Digital Credentials Service"
      }
    }
  ]
}