{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://we-build.example/schemas/eucc-attestation-credential.schema.json",
  "title": "European Company Certificate Attestation Credential",
  "description": "Example credential claim schema derived from docs/v1.0_eucc_attestation_descriptio.docx for use in iGrant EUDI issuance exercises.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "legal_person_name",
    "legal_person_id",
    "legal_form_type",
    "registration_member_state",
    "registered_address",
    "registration_date",
    "legal_person_status",
    "legal_person_activity",
    "legal_representative"
  ],
  "properties": {
    "legal_person_name": {
      "type": "string",
      "description": "Official current legal person name as recorded in the business register.",
      "examples": [
        "We Build Oy"
      ]
    },
    "legal_person_id": {
      "type": "string",
      "description": "Unique identifier for the legal person in the EUID structure.",
      "pattern": "^[A-Z]{2}[A-Z0-9]+\\.[A-Za-z0-9.-]+$",
      "examples": [
        "FIHPR.1234567-8"
      ]
    },
    "legal_form_type": {
      "type": "string",
      "description": "Legal form of the company.",
      "examples": [
        "Oy"
      ]
    },
    "registration_member_state": {
      "type": "string",
      "description": "Member State of registration expressed as an ISO 3166-1 alpha-2 code.",
      "pattern": "^[A-Z]{2}$",
      "examples": [
        "FI"
      ]
    },
    "registered_address": {
      "$ref": "#/$defs/RegisteredAddress"
    },
    "registration_date": {
      "type": "string",
      "format": "date",
      "description": "Date on which the company was registered. It should be equal to or earlier than the issuance date of the attestation."
    },
    "share_capital": {
      "type": "string",
      "description": "Subscribed capital with currency when disclosed.",
      "examples": [
        "EUR 2500"
      ]
    },
    "legal_person_status": {
      "type": "string",
      "description": "Status of the legal entity in national law or the national register.",
      "examples": [
        "active",
        "in_liquidation"
      ]
    },
    "legal_person_activity": {
      "description": "Main activity code or codes for the legal person, such as NACE or ATECO.",
      "oneOf": [
        {
          "type": "string",
          "examples": [
            "41.20"
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "examples": [
            [
              "41.20",
              "43.29"
            ]
          ]
        }
      ]
    },
    "legal_person_duration": {
      "type": "string",
      "description": "Duration of the company if it has a limited duration.",
      "examples": [
        "until 2035-12-31"
      ]
    },
    "contact_point": {
      "$ref": "#/$defs/ContactPoint"
    },
    "legal_representative": {
      "type": "array",
      "description": "Persons or legal entities authorized to represent the company.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/LegalRepresentative"
      }
    }
  },
  "$defs": {
    "RegisteredAddress": {
      "type": "object",
      "description": "Official registered address of the company.",
      "additionalProperties": false,
      "required": [
        "registered_address_full_address"
      ],
      "properties": {
        "registered_address_full_address": {
          "type": "string",
          "description": "Complete address string, typically semicolon-separated in the source model.",
          "examples": [
            "Aleksanterinkatu 12; 00170 Helsinki; Finland"
          ]
        },
        "registered_address_care_of": {
          "type": "string",
          "description": "Care-of line when the address is at another person or entity."
        },
        "registered_address_thoroughfare": {
          "type": "string",
          "description": "Street or thoroughfare name."
        },
        "registered_address_locator_designator": {
          "type": "string",
          "description": "Street number, building number, or similar locator designator."
        },
        "registered_address_post_code": {
          "type": "string",
          "description": "Postal code."
        },
        "registered_address_post_name": {
          "type": "string",
          "description": "Postal town or locality."
        },
        "registered_address_post_office_box": {
          "type": "string",
          "description": "Post office box."
        },
        "registered_address_locator_name": {
          "type": "string",
          "description": "Building, property, or site name."
        },
        "registered_address_admin_unit_level_1": {
          "type": "string",
          "description": "Administrative unit level 1, typically the country."
        },
        "registered_address_admin_unit_level_2": {
          "type": "string",
          "description": "Administrative unit level 2, such as region, state, or county."
        }
      }
    },
    "ContactPoint": {
      "type": "object",
      "description": "Correspondence channel information for the company.",
      "additionalProperties": false,
      "properties": {
        "contact_email": {
          "type": "string",
          "format": "email",
          "description": "Company email address.",
          "examples": [
            "contact@webuild.example"
          ]
        },
        "contact_page": {
          "type": "string",
          "format": "uri",
          "description": "Company website or contact page.",
          "examples": [
            "https://webuild.example"
          ]
        }
      }
    },
    "NaturalPersonRepresentative": {
      "type": "object",
      "description": "Natural person authorized to represent the company.",
      "additionalProperties": false,
      "required": [
        "legal_representative_natural_person_full_name",
        "legal_representative_natural_person_date_of_birth"
      ],
      "properties": {
        "legal_representative_natural_person_identifier": {
          "type": "string",
          "description": "Identifier of the natural person representative when disclosed."
        },
        "legal_representative_natural_person_full_name": {
          "type": "string",
          "description": "Full name of the natural person representative.",
          "examples": [
            "Aino Korhonen"
          ]
        },
        "legal_representative_natural_person_date_of_birth": {
          "type": "string",
          "format": "date",
          "description": "Date of birth of the natural person representative."
        },
        "legal_representative_natural_person_nationality": {
          "type": "string",
          "description": "Nationality of the natural person representative.",
          "pattern": "^[A-Z]{2}$",
          "examples": [
            "FI"
          ]
        }
      }
    },
    "LegalPersonRepresentative": {
      "type": "object",
      "description": "Legal person authorized to represent the company.",
      "additionalProperties": false,
      "required": [
        "legal_representative_legal_person_name",
        "legal_representative_legal_person_id",
        "legal_representative_legal_person_legal_form_type"
      ],
      "properties": {
        "legal_representative_legal_person_name": {
          "type": "string",
          "description": "Official legal person name as recorded in the register.",
          "examples": [
            "Nordic Holdings Oy"
          ]
        },
        "legal_representative_legal_person_id": {
          "type": "string",
          "description": "Unique EUID-style identifier of the legal person representative.",
          "pattern": "^[A-Z]{2}[A-Z0-9]+\\.[A-Za-z0-9.-]+$",
          "examples": [
            "FIHPR.7654321-0"
          ]
        },
        "legal_representative_legal_person_legal_form_type": {
          "type": "string",
          "description": "Legal form of the legal person representative.",
          "examples": [
            "Oy"
          ]
        }
      }
    },
    "SignatoryRule": {
      "description": "Whether the representative binds the company alone or jointly.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "sole",
            "joint",
            "joint_two",
            "joint_all",
            "limited"
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "sole",
              "joint",
              "joint_two",
              "joint_all",
              "limited"
            ]
          },
          "uniqueItems": true
        }
      ]
    },
    "LegalRepresentative": {
      "type": "object",
      "description": "Representative entry with either a natural person or legal person representative plus a signatory rule.",
      "additionalProperties": false,
      "required": [
        "signatory_rule"
      ],
      "properties": {
        "legal_representative_natural_person": {
          "$ref": "#/$defs/NaturalPersonRepresentative"
        },
        "legal_representative_legal_person": {
          "$ref": "#/$defs/LegalPersonRepresentative"
        },
        "signatory_rule": {
          "$ref": "#/$defs/SignatoryRule"
        }
      },
      "oneOf": [
        {
          "required": [
            "legal_representative_natural_person"
          ]
        },
        {
          "required": [
            "legal_representative_legal_person"
          ]
        }
      ]
    }
  },
  "examples": [
    {
      "legal_person_name": "We Build Oy",
      "legal_person_id": "FIHPR.1234567-8",
      "legal_form_type": "Oy",
      "registration_member_state": "FI",
      "registered_address": {
        "registered_address_full_address": "Aleksanterinkatu 12; 00170 Helsinki; Finland",
        "registered_address_thoroughfare": "Aleksanterinkatu",
        "registered_address_locator_designator": "12",
        "registered_address_post_code": "00170",
        "registered_address_post_name": "Helsinki",
        "registered_address_admin_unit_level_1": "Finland",
        "registered_address_admin_unit_level_2": "Uusimaa"
      },
      "registration_date": "2018-05-07",
      "share_capital": "EUR 2500",
      "legal_person_status": "active",
      "legal_person_activity": [
        "41.20"
      ],
      "contact_point": {
        "contact_email": "contact@webuild.example",
        "contact_page": "https://webuild.example"
      },
      "legal_representative": [
        {
          "legal_representative_natural_person": {
            "legal_representative_natural_person_identifier": "FI-PID-010180-123A",
            "legal_representative_natural_person_full_name": "Aino Korhonen",
            "legal_representative_natural_person_date_of_birth": "1980-01-01",
            "legal_representative_natural_person_nationality": "FI"
          },
          "signatory_rule": "sole"
        }
      ]
    }
  ]
}